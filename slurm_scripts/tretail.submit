#!/usr/bin/bash
#SBATCH --output=/users/%u/pyspn-map-benchmark/hpc_outs/tretail%j.out
#SBATCH --nodes=1
#SBATCH --ntasks=40
#SBATCH --time=0-48:00

module load anaconda3/2022.10-gcc-13.2.0
source /users/${USER}/.bashrc
source activate pyspn

# Navigate to project root (IMPORTANT when .submit is in subdirectory)
cd /users/${USER}/pyspn-map-benchmark
# Alternative: cd $SLURM_SUBMIT_DIR (if you submit from project root)

# Verify we're in the right place
echo "=== Working Directory ==="
pwd
ls -la experiment_scripts/benchmark.py  # Check file exists
echo "========================="

# Verify environment activation
echo "=== Environment Check ==="
echo "Current conda environment: $CONDA_DEFAULT_ENV"
python --version
echo "========================="

# Test
# DATETIME=$(date +"%d-%m-%Y %H:%M:%S")
# python experiment_scripts/benchmark.py -m MP AMP PACMAP PACMAP-H --no-learn --data-path small_datasets -d car -q 0.1 -e 0.9 -dt "$DATETIME" 

DATETIME=$(date +"%d-%m-%Y %H:%M:%S")
# python experiment_scripts/make_queries_and_evids.py -dp 20-datasets -all -q 0.1 -e 0.1
# python experiment_scripts/benchmark.py -m MP AMP MS PACMAP --no-learn --data-path 20-datasets -all -q 0.1 -e 0.1 -dt "$DATETIME"
# python experiment_scripts/plot_results.py -q 0.1 -e 0.1 -dn 20-datasets -dt "$DATETIME"
echo "=== tretail starting at $(date '+%H:%M:%S') ==="
time {
    # python experiment_scripts/make_queries_and_evids.py -dp 20-datasets -all -q 0.4 -e 0.6
    EXPERIMENT_ID=15_05_26
    python experiment_scripts/benchmark.py \
        -m PACMAP-H \
        --data-path 20-datasets \
        -d tretail \
        -q 0.1 \
        -e 0.9 \
        -dt "$DATETIME" \
        -id $EXPERIMENT_ID \
        --batch-size 250
    EXPERIMENT_ID=15_05_26
    python experiment_scripts/benchmark.py \
        -m PACMAP-H \
        --data-path 20-datasets \
        -d tretail \
        -q 0.25 \
        -e 0.75 \
        -dt "$DATETIME" \
        -id $EXPERIMENT_ID \
        --batch-size 250
    EXPERIMENT_ID=15_05_26
    python experiment_scripts/benchmark.py \
        -m PACMAP-H \
        --data-path 20-datasets \
        -d tretail \
        -q 0.5 \
        -e 0.5 \
        -dt "$DATETIME" \
        -id $EXPERIMENT_ID \
        --batch-size 250
    # python experiment_scripts/plot_results.py \
    #     -q 0.4 \
    #     -e 0.6 \
    #     -dn 20-datasets \
    #     -dt "$DATETIME"
}
echo ""